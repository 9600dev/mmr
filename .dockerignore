# ignore .git and .cache folders
.git
.cache
# Secrets: docker-compose loads .env at runtime via `env_file`, so it must NOT
# be baked into the image (image layers are shippable and would leak live IB
# credentials). Keep the example template for reference.
.env
.env.*
!.env.example
secrets.env
*.secrets
# Local-only account/strategy state must not enter a distributable image.
docs/OPERATIONAL_STATE.md
.venv
.devcontainer
.vscode
.python_version
temp
scratch
data
third_party
.gitignore
.mypy_cache
.pytest_cache
# Mutation testing generates altered source trees; they are never runtime code.
mutants
__pycache__
logs
